#!/usr/bin/env bash
# script to install HamClock on RPi

# ---------------------------------------------------------------------------
# Headless / CI support (added on top of the upstream script so it can be
# driven from an automated Raspberry Pi OS image build, e.g. GitHub Actions).
#
#   HC_NONINTERACTIVE=1     Skip all y/n and select-menu prompts, using the
#                            defaults below (or the per-question defaults
#                            noted). When unset, the script behaves exactly
#                            as it always has.
#   HC_BUILD_MODE=web|hardware|fb0
#                            Which HamClock build to produce. Default: web
#                            (or derived from HC_FORCE_WEBONLY below if set,
#                            for backward compatibility). "hardware" needs a
#                            live X11 display and is not buildable inside a
#                            CI chroot without a real or virtual X server.
#                            "fb0" draws directly to /dev/fb0 -- no X11, no
#                            desktop environment, lightest-weight option for
#                            a dedicated on-screen display.
#   HC_FORCE_WEBONLY=y|n    Legacy alias: y -> HC_BUILD_MODE=web, n ->
#                            HC_BUILD_MODE=hardware. Ignored if
#                            HC_BUILD_MODE is set. Default: y.
#   HC_SIZE=800x480|1600x960|2400x1440|3200x1920
#                            Build size for web/fb0. Default: 800x480.
#   HC_FB_DEPTH=16|32       Optional framebuffer color depth override,
#                            passed as FB_DEPTH=<n> to make. Only used for
#                            HC_BUILD_MODE=fb0. Leave unset to use the
#                            Makefile's own default; set to 16 if HamClock
#                            fails to set 32-bit color mode on your
#                            hardware's framebuffer driver.
#   HC_AUTOSTART=y|n        Start HamClock automatically on boot (desktop
#                            autostart entry for hardware, or a systemd
#                            service -- with automatic crash restart -- for
#                            web and fb0). Default: y.
#   HC_ALLOW_SUDO=1         Allow running as root/under sudo. Most CI chroots
#                            run everything as root directly, so SUDO_USER is
#                            unset there anyway and this normally isn't
#                            needed; it exists for chroot/nspawn setups that
#                            do invoke this script via sudo.
#
# All existing command-line behavior (e.g. `-t <version>`) is unchanged, and
# every prompt still works interactively when HC_NONINTERACTIVE is unset.
# ---------------------------------------------------------------------------


# set log file
LOGFN=$PWD/$(basename $0).log


# find largest supported hamclock build size
function largestsize ()
{
    # get screen size
    read SW SH < <(xdpyinfo -display :0 | perl -ne '/dimensions: *(\d+)x(\d+)/ and print "$1 $2\n"')
    # echo $SW $SH

    # find HC fractions in each dimension
    HCW=800
    HCH=480
    HCWX=$(($SW/$HCW))
    HCHX=$(($SH/$HCH))
    # echo $HCWX $HCHX

    # use smaller fraction so both dimensions fit
    if (( $HCWX >= $HCHX )) ; then
        HCW=$(($HCW * $HCHX))
        HCH=$(($HCH * $HCHX))
    else
        HCW=$(($HCW * $HCWX))
        HCH=$(($HCH * $HCWX))
    fi

    echo $SW $SH $HCW $HCH
}


# ask "$1? [y/n] " then return 0 if respond y or 1 if respond n
# $2, if given, is the answer used automatically when HC_NONINTERACTIVE=1
# (defaults to "y" if omitted).
function ask ()
{
    local prompt="$1"
    local default="$2"

    echo "" >> $LOGFN
    echo "asking: $prompt?" >> $LOGFN

    if [ "$HC_NONINTERACTIVE" = "1" ] ; then
        ANS="${default:-y}"
        echo "non-interactive default: $ANS" >> $LOGFN
        [ "$ANS" = "y" ]
        return
    fi

    ANS=x
    while [ "$ANS" != "y" ] && [ "$ANS" != "n" ]; do
        echo ""
        echo -n "$prompt? [y/n] "
        read ANS
    done

    echo "answer: $ANS" >> $LOGFN

    [ "$ANS" = "y" ]
}

# print blank line then $*
function inform ()
{
    echo "" >> $LOGFN
    echo $* >> $LOGFN

    echo ""
    echo $*
    echo ""
}

# dump rpi configuration
function dumpConfig ()
{
    echo os-release
    cat /etc/os-release

    echo uname
    uname -a

    echo free -m
    free -m

    echo df
    df

    echo ping home
    ping -c 3 -W 3 clearskyinstitute.com || true
}

# when requesting a specific hamclock version, find it in github
function get_hamclock_source_url()
{
    local substring=$1

    if [ -z "$substring" ]; then
        echo "Usage: get_hamclock_url <version_substring> (e.g., 4.22)" >&2
        return 1
    fi

    # GitHub API endpoint for releases
    local api_url="https://api.github.com/repos/openhamclock/hamclock/releases"

    # Define the target filename we are looking for
    local target_asset="ESPHamClock-V${substring}.zip"

    # 1. Fetch releases
    # 2. Flatten all assets into one list
    # 3. Filter for the specific filename
    # 4. Grab the first (latest) matching URL
    local download_url=$(curl -s "$api_url" | jq -r --arg target "$target_asset" '
        map(.assets[])
        | .[]
        | select(.name == $target)
        | .browser_download_url
    ' | head -n 1)

    if [ -z "$download_url" ] || [ "$download_url" == "null" ]; then
        echo "Error: Asset '$target_asset' not found on GitHub." >&2
        return 1
    fi
    TBURL="$download_url"
}

function find_latest_tag()
{
    ALL_TAGS_JSON=$(curl -s "https://api.github.com/repos/$GITHUB_REPO/tags")
    STABLE_TAG=$(echo "$ALL_TAGS_JSON" | jq -r '.[].name' | grep -v "b" | sort -V | tail -n 1)
    BETA_TAG=$(echo "$ALL_TAGS_JSON" | jq -r '.[].name' | grep "b" | sort -V | tail -n 1)
}


######################################################################################
#
# execution starts here
#
######################################################################################

# fresh
[ -t 1 ] && clear

# sudo?
if [ "$SUDO_USER" != "" ] && [ "$HC_ALLOW_SUDO" != "1" ] ; then
    inform Do not run this with sudo
    exit 1
fi

# really a pi?
OSR=/etc/os-release
if ! egrep -qs 'bullseye|bookworm|trixie' $OSR ; then
    inform This script only works on Raspberry Pi OS bullseye, bookworm or trixie.
    exit 1
fi

# fresh log
rm -f $LOGFN

# really do it?
inform This script will install HamClock on Raspberry Pi OS.
if ! ask "Proceed" "y" ; then exit 1; fi


# check for another instance
if sudo pkill -0 '^hamclock$' ; then
    inform Another hamclock seems to be running already.
    inform Please exit the existing hamclock then retry this script.
    exit 0
fi

# inform log file
inform A transcript of this installation may be found in $LOGFN
echo -n HamClock installation begins at " " >> $LOGFN
date -u >> $LOGFN
dumpConfig >> $LOGFN


# insure necessary helper packages are installed
inform Installing required helper packages ...
PKGS="\
    curl \
    fbset \
    g++ \
    gpiod \
    jq \
    libgpiod-dev \
    libx11-dev \
    linux-libc-dev \
    make \
    openssl \
    unzip \
    x11-utils \
    xdg-utils \
    xserver-xorg\
"
sudo apt-get -y -o Acquire::Check-Valid-Until=false update >> $LOGFN 2>&1
sudo apt-get -y install $PKGS >> $LOGFN 2>&1
if (( $? != 0 )) ; then echo error loading packages; exit 1; fi

TBALL=ESPHamClock.zip
if [ "$1" == -t ]; then
    # requesting a specific version
    if [ -z "$2" ]; then
        echo "The -t argument requires a version like 4.22."
        exit 1
    fi
    get_hamclock_source_url "$2"
else
    # latest release
    TBURL=https://ohb.hamclock.app/ham/HamClock/$TBALL
fi

# download fresh program source
rm -f $TBALL
inform Downloading $TBURL ...
if ! curl -A 'install-hc-rpi' -L --silent --show-error --output $TBALL $TBURL >> $LOGFN 2>&1 ; then
    inform Error downloading $TBURL -- see $LOGFN
    exit 1
fi


# explode
XDIR=ESPHamClock
rm -fr $XDIR
inform Exploding $TBALL into $XDIR ...
if ! unzip $TBALL >> $LOGFN 2>&1 ; then inform Error exploding archive -- see $LOGFN; exit 1; fi
rm $TBALL


# cd inside for make
cd $XDIR


# pick a build mode
if [ "$HC_NONINTERACTIVE" = "1" ] ; then
    if [ -n "$HC_BUILD_MODE" ] ; then
        MODE="$HC_BUILD_MODE"
    elif [ "${HC_FORCE_WEBONLY:-y}" = "y" ] ; then
        MODE=web
    else
        MODE=hardware
    fi
else
    # fb0 is CI/automation-only, not offered in the interactive flow, to
    # keep the original interactive UX unchanged.
    if ask "build for web access only (no hardware display)" ; then MODE=web; else MODE=hardware; fi
fi

if [ "$MODE" = "web" ] ; then

    # just ask all sizes
    echo ""
    if [ "$HC_NONINTERACTIVE" = "1" ] ; then
        size="${HC_SIZE:-800x480}"
        case "$size" in
            800x480|1600x960|2400x1440|3200x1920) ;;
            *) inform "Invalid HC_SIZE=$size, defaulting to 800x480"; size=800x480 ;;
        esac
        inform "Non-interactive: selected HamClock size $size"
    else
        PS3="Select desired HamClock size (1-4): "
        select size in "800x480" "1600x960" "2400x1440" "3200x1920"; do
            if (( $REPLY >= 1 && $REPLY <= 4 )) ; then break; fi
        done
    fi
    HC_BUILD="hamclock-web-$size"
    HC_WEBONLY=1
    HC_FB0=0

elif [ "$MODE" = "fb0" ] ; then

    # Framebuffer build: draws directly to /dev/fb0, no X11 involved, so
    # this is always non-interactive-only (fb0 is never offered above).
    size="${HC_SIZE:-800x480}"
    case "$size" in
        800x480|1600x960|2400x1440|3200x1920) ;;
        *) inform "Invalid HC_SIZE=$size, defaulting to 800x480"; size=800x480 ;;
    esac
    inform "Non-interactive: selected HamClock size $size (framebuffer build)"
    HC_BUILD="hamclock-fb0-$size"
    HC_WEBONLY=0
    HC_FB0=1

elif [ "$HC_NONINTERACTIVE" = "1" ] ; then

    # No live X11 display to query in a CI chroot, and largestsize() needs
    # one. Skip auto-detection entirely and take the size straight from
    # HC_SIZE, same as the web-only path does.
    size="${HC_SIZE:-800x480}"
    case "$size" in
        800x480|1600x960|2400x1440|3200x1920) ;;
        *) inform "Invalid HC_SIZE=$size, defaulting to 800x480"; size=800x480 ;;
    esac
    inform "Non-interactive: selected HamClock size $size (hardware build)"
    HC_BUILD="hamclock-$size"
    HC_WEBONLY=0
    HC_FB0=0

else

    # ask desired size from ones that fit unless it can only be 800x480
    read SW SH LHCW LHCH < <(largestsize)
    inform Display size appears to be ${SW}x${SH}.
    if (( $LHCW < 800 || $LHCH < 480 )) ; then
        inform HamClock requires at least 800x480.
        exit
    elif (( $LHCW == 800 )) ; then
        size="800x480"
    elif (( $LHCW == 1600 )) ; then
        PS3="Select desired HamClock size (1-2): "
        select size in "800x480" "1600x960"; do
            if (( $REPLY >= 1 && $REPLY <= 2 )) ; then break; fi
        done
    elif (( $LHCW == 2400 )) ; then
        PS3="Select desired HamClock size (1-3): "
        select size in "800x480" "1600x960" "2400x1440" ; do
            if (( $REPLY >= 1 && $REPLY <= 3 )) ; then break; fi
        done
    else
        PS3="Select desired HamClock size (1-4): "
        select size in "800x480" "1600x960" "2400x1440" "3200x1920"; do
            if (( $REPLY >= 1 && $REPLY <= 4 )) ; then break; fi
        done
    fi
    HC_BUILD="hamclock-$size"
    HC_WEBONLY=0
    HC_FB0=0
fi



# build with rough progress indication
let NLOGLINES=133
inform Building $HC_BUILD ...
WC0=$(wc -l < $LOGFN)
MAKE_VARS=""
if [ -n "$HC_FB_DEPTH" ] ; then
    MAKE_VARS="FB_DEPTH=$HC_FB_DEPTH"
fi
echo running make $MAKE_VARS $HC_BUILD >> $LOGFN
make $MAKE_VARS $HC_BUILD >> $LOGFN 2>&1 &
job=$!
while kill -0 $job 2>/dev/null; do
    if [ -t 1 ] ; then
        sleep .5
        let percent="100 * ( $(wc -l < $LOGFN) - $WC0 ) / $NLOGLINES"
        printf "%2d%%\r" $percent
    else
        sleep 5
        let percent="100 * ( $(wc -l < $LOGFN) - $WC0 ) / $NLOGLINES"
        echo "building... ${percent}%"
    fi
done
[ -t 1 ] && printf "\rfinished\n"
if ! wait %1 >> $LOGFN 2>&1 ; then inform Build failed -- see $LOGFN; exit 1; fi

# install
if ! sudo make install >> $LOGFN 2>&1 ; then inform Install failed -- see $LOGFN; exit 1; fi




# icon?
if [ -d $HOME/Desktop ] && [ $HC_WEBONLY -eq 0 ] ; then
    HCDT=$HOME/Desktop/hamclock.desktop
    HCPNG=$HOME/.hamclock/hamclock.png
    if ask "install HamClock desktop icon" "y" ; then
        mkdir -p $HOME/.hamclock
        rm -f $HCDT $HCPNG
        cp hamclock.png $HCPNG
        sed -e "s^Icon.*^Icon=$HOME/.hamclock/hamclock.png^" < hamclock.desktop > $HCDT
        chmod u+x $HCDT
    else
        rm -f $HCDT $HCPNG
    fi
elif [ "$HC_NONINTERACTIVE" = "1" ] && [ "${HC_FB0:-0}" -ne 1 ] && [ $HC_WEBONLY -eq 0 ] ; then
    # $HOME is root during a CI build, which never has a Desktop folder, so
    # the check above always misses. Install into /etc/skel instead, so the
    # icon is copied into the pi account's home automatically when
    # userconf.txt creates it at first boot. NOTE: this hardcodes
    # /home/pi -- if the default username set elsewhere in this pipeline
    # ever changes, this path needs to change with it.
    if ask "install HamClock desktop icon" "y" ; then
        SKEL_HAMCLOCK=/etc/skel/.hamclock
        SKEL_DESKTOP=/etc/skel/Desktop
        mkdir -p "$SKEL_HAMCLOCK" "$SKEL_DESKTOP"
        cp hamclock.png "$SKEL_HAMCLOCK/hamclock.png"
        sed -e "s^Icon.*^Icon=/home/pi/.hamclock/hamclock.png^" < hamclock.desktop > "$SKEL_DESKTOP/hamclock.desktop"
        chmod u+x "$SKEL_DESKTOP/hamclock.desktop"
        inform Installed desktop icon template in /etc/skel: $SKEL_DESKTOP/hamclock.desktop
    fi
fi


# User Guide?
if [ -d ~/Desktop ] && [ $HC_WEBONLY -eq 0 ] ; then
    UGFN=HamClockUserGuide.pdf
    DTFN="$HOME/Desktop/$UGFN"

    if ask "install User Guide on desktop" "y" ; then
        ALL_TAGS_JSON=$(curl -s "https://api.github.com/repos/openhamclock/hamclock/tags")
        STABLE_TAG=$(echo "$ALL_TAGS_JSON" | jq -r '.[].name' | grep -v "b" | sort -V | tail -n 1)

        if [ -z "$STABLE_TAG" ]; then
            inform Error finding latest HamClock release tag -- see "$LOGFN"
        else
            UGURL="https://github.com/openhamclock/hamclock/releases/download/$STABLE_TAG/$UGFN"
            if ! curl --location --silent --show-error --output "$DTFN" "$UGURL" >> "$LOGFN" 2>&1 ; then
                inform Error downloading "$UGURL" -- see "$LOGFN"
            fi
        fi
    else
        rm -f "$DTFN"
    fi
fi


# man page?
MPATH=/usr/local/share/man/man1
if [ -d $MPATH ] && [ $HC_WEBONLY -eq 0 ] && ask "install HamClock man page" "y" ; then
    # name changed from .man to .1 as of 2.98
    if [ -r hamclock.man ] ; then
        sudo cp hamclock.man $MPATH/hamclock.1
    else
        sudo cp hamclock.1 $MPATH
    fi
fi


# start on boot?
if ask "start HamClock automatically each time Pi is booted" "${HC_AUTOSTART:-y}" ; then
    if [ "${HC_FB0:-0}" -eq 1 ] ; then
        # framebuffer build: no X11/desktop involved at all, so this runs
        # as a plain systemd service instead of a desktop autostart entry
        # or crontab job. Needs root to open /dev/fb0, /dev/tty1, and
        # /dev/input directly.
        cat > /etc/systemd/system/hamclock.service <<SVCEOF
[Unit]
Description=HamClock framebuffer display
After=multi-user.target
StartLimitIntervalSec=0

[Service]
ExecStartPre=/usr/bin/fbset -depth 32
ExecStartPre=/usr/bin/sleep 10
Type=simple
ExecStart=/usr/local/bin/hamclock
Restart=on-failure
RestartSec=3
User=root
Group=root

[Install]
WantedBy=multi-user.target
SVCEOF
        sudo systemctl enable hamclock.service >> $LOGFN 2>&1
        inform Installed framebuffer autostart service: /etc/systemd/system/hamclock.service
    elif [ $HC_WEBONLY -eq 0 ] ; then
        if [ "$HC_NONINTERACTIVE" = "1" ] ; then
            # $HOME is root during a CI build, not whatever account will
            # actually log into the desktop once the image is flashed and
            # a user is created via Raspberry Pi Imager. Install a
            # system-wide autostart entry instead, so it applies no matter
            # who logs in. Note this still only runs once someone actually
            # logs into the graphical desktop -- enable auto-login in
            # Imager's OS customization options for a fully hands-off boot.
            SYS_AUTOSTART=/etc/xdg/autostart
            mkdir -p $SYS_AUTOSTART
            # Rebuild the Exec= line rather than patching it in place: adds
            # -f on for fullscreen, and makes HamClock wait for genuine
            # internet connectivity (not just an interface reporting
            # "connected" -- that only means an IP was leased, not that the
            # network actually has a working path out) before launching,
            # since HamClock's own NTP check can hang indefinitely if it
            # runs during that gap. Falls through after 60s regardless, so
            # a genuinely offline network doesn't block startup forever.
            grep -v '^Exec=' hamclock.desktop > hamclock-base.desktop
            {
                cat hamclock-base.desktop
                echo "Exec=sh -c 'until [ -n \"\$DISPLAY\" ] || [ -n \"\$WAYLAND_DISPLAY\" ]; do sleep 1; done; i=0; while [ \$i -lt 30 ] && [ \"\$(nmcli networking connectivity)\" != \"full\" ]; do sleep 2; i=\$((i+1)); done; sleep 5; exec /usr/local/bin/hamclock -f on'"
            } > $SYS_AUTOSTART/hamclock.desktop
            inform Installed system-wide autostart entry, fullscreen by default: $SYS_AUTOSTART/hamclock.desktop
        else
            # use desktop system
            DOTCFG=$HOME/.config
            if [ -d $DOTCFG ] ; then
                ASPATH=$DOTCFG/autostart
                ASFILE=$ASPATH/hamclock.desktop
                mkdir -p $ASPATH
                if [ -e "$ASFILE" ] ; then
                    inform Autostart file already exists, leaving it unchanged: $ASFILE
                else
                    grep -v '^Exec=' hamclock.desktop > hamclock-base.desktop
                    {
                        cat hamclock-base.desktop
                        echo "Exec=sh -c 'until [ -n \"\$DISPLAY\" ] || [ -n \"\$WAYLAND_DISPLAY\" ]; do sleep 1; done; i=0; while [ \$i -lt 30 ] && [ \"\$(nmcli networking connectivity)\" != \"full\" ]; do sleep 2; i=\$((i+1)); done; sleep 5; exec /usr/local/bin/hamclock -f on'"
                    } > "$ASFILE"
                fi
            else
                inform Error: $DOTCFG does not exist
            fi
        fi
    else
        # web build: a real systemd service instead of a bare @reboot cron
        # entry, so a crash gets restarted automatically (cron only runs it
        # once, at boot, with no supervision and no captured logs) and
        # journalctl actually has something to show when it dies.
        cat > /etc/systemd/system/hamclock.service <<SVCEOF
[Unit]
Description=HamClock web server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/hamclock
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
SVCEOF
        sudo systemctl enable hamclock.service >> $LOGFN 2>&1
        inform Installed web autostart service: /etc/systemd/system/hamclock.service
    fi
else
    # undo autostarting
    if [ "${HC_FB0:-0}" -eq 1 ] ; then
        sudo systemctl disable hamclock.service >> $LOGFN 2>&1 || true
        sudo rm -f /etc/systemd/system/hamclock.service
    elif [ $HC_WEBONLY -eq 0 ] ; then
        rm -f $HOME/.config/autostart/hamclock.desktop
    else
        sudo systemctl disable hamclock.service >> $LOGFN 2>&1 || true
        sudo rm -f /etc/systemd/system/hamclock.service
    fi
fi
inform HamClock installation is complete.
inform You may now run HamClock by typing hamclock.
